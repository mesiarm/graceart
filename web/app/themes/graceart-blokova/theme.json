			"fontSizes": [
				{
					"slug": "small",
					"name": "Malé",
					"size": "14px"
				},
				{
					"slug": "medium",
					"name": "Stredné",
					"size": "17px"
				},
				{
					"slug": "large",
					"name": "Veľké",
					"size": "22px"
				},
				{
					"slug": "x-large",
					"name": "Extra veľké",
					"size": "34px",
					"fluid": {
						"min": "28px",
						"max": "34px"
					}
				},
				{
					"slug": "xx-large",
					"name": "Najväčšie",
					"size": "56px",
					"fluid": {
						"min": "36px",
						"max": "56px"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vh",
				"vw"
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|body-text"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|jost",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.7",
			"fontWeight": "400"
		},
		"spacing": {
			"blockGap": "24px"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|brown"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|brown-dark"
					}
				}
			},
			"heading": {
				"color": {
					"text": "var:preset|color|ink"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|eb-garamond",
					"fontWeight": "400",
					"textTransform": "uppercase",
					"letterSpacing": "0.03em",
					"lineHeight": "1.15"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "24px"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|brown",
					"text": "var:preset|color|base"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|jost",
					"fontSize": "13px",
					"fontWeight": "400",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				"border": {
					"radius": "999px"
				},
				"spacing": {
					"padding": {
						"top": "12px",
						"bottom": "12px",
						"left": "26px",
						"right": "26px"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|brown-dark",
						"text": "var:preset|color|base"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var:preset|font-family|great-vibes",
					"fontSize": "60px",
					"fontWeight": "400",
					"textTransform": "none",
					"letterSpacing": "0",
					"lineHeight": "1"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "17px",
					"fontWeight": "500",
					"textTransform": "uppercase",
					"letterSpacing": "0.06em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|ink"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|brown"
							}
						}
					}
				}
			},
			"core/quote": {
				"typography": {
					"fontFamily": "var:preset|font-family|cormorant",
					"fontStyle": "italic"
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Hlavička",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pätička",
			"area": "footer"
		}
	]
}
