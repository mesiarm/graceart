{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"palette": [
				{
					"slug": "base",
					"name": "Biela",
					"color": "#FFFFFF"
				},
				{
					"slug": "cream",
					"name": "Krémová",
					"color": "#F7F3EE"
				},
				{
					"slug": "line",
					"name": "Línia",
					"color": "#E6DCCF"
				},
				{
					"slug": "muted",
					"name": "Tlmená hnedá",
					"color": "#6B5B4D"
				},
				{
					"slug": "body-text",
					"name": "Text",
					"color": "#5A4A3D"
